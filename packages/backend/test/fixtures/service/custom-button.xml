<?xml version="1.0" encoding="UTF-8"?>
<root>
  <global>
    <work_dir>.</work_dir>
    <xresloader_path>custom-button.xml</xresloader_path>
  </global>
  <list>
    <item name="pa" file="a.proto" scheme="Kind"/>
    <item name="pb" file="b.proto" scheme="Kind"/>
    <item name="xa"><scheme name="DataSource">x.xlsx|s1|1,1</scheme></item>
    <item name="xb"><scheme name="DataSource">y.xlsx|s2|1,1</scheme></item>
  </list>
  <gui>
    <on_before_convert name="前置可关">resolve();</on_before_convert>
    <on_before_convert name="前置锁定" mutable="no">resolve();</on_before_convert>
    <on_after_convert><![CDATA[resolve();]]></on_after_convert>
    <on_append_log name="日志可关">resolve();</on_append_log>
    <script name="counter"><![CDATA[
      data.counter = (data.counter || 0) + 1;
      log_info("COUNTER=" + data.counter);
      resolve();
    ]]></script>
    <script name="patch"><![CDATA[
      if (selected_items.length > 0) {
        selected_items[0].name = "patched-by-button";
      }
      resolve();
    ]]></script>
  </gui>
</root>
