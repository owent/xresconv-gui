<?xml version="1.0" encoding="UTF-8"?>
<root>
  <global>
    <work_dir>.</work_dir>
    <xresloader_path>run-append-log.xml</xresloader_path>
  </global>
  <list>
    <item name="one"><scheme name="DataSource">a.xlsx|s1|1,1</scheme></item>
  </list>
  <gui>
    <on_before_convert><![CDATA[log_info("chain-target"); resolve();]]></on_before_convert>
    <on_append_log><![CDATA[data.message = "[H1] " + data.message;]]></on_append_log>
    <on_append_log><![CDATA[data.message = String(data.message).toUpperCase();]]></on_append_log>
  </gui>
</root>
