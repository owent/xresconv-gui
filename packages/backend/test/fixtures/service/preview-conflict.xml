<?xml version="1.0" encoding="UTF-8"?>
<root>
  <global>
    <work_dir>.</work_dir>
    <xresloader_path>preview-conflict.xml</xresloader_path>
    <!-- 两条同 type/目录/重命名的规则（tag 不同）：tag="a b" 的条目被两条同时
         命中 → 同一条目重复发射 → 真实冲突；仅 tag="a" 的条目只命中一条 → 正常。 -->
    <output_type output_dir="same-out" rename="/(?i)\.bin$/.lua/" tag="a">lua</output_type>
    <output_type output_dir="same-out" rename="/(?i)\.bin$/.lua/" tag="b">lua</output_type>
  </global>
  <list>
    <item name="one" tag="a b"><scheme name="DataSource">a.xlsx|s1|1,1</scheme></item>
    <item name="two" tag="a"><scheme name="DataSource">b.xlsx|s1|1,1</scheme></item>
  </list>
</root>
