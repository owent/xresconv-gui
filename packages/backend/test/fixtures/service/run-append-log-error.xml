<?xml version="1.0" encoding="UTF-8"?>
<root>
  <global>
    <work_dir>.</work_dir>
    <xresloader_path>run-append-log-error.xml</xresloader_path>
  </global>
  <list>
    <item name="one"><scheme name="DataSource">a.xlsx|s1|1,1</scheme></item>
  </list>
  <gui>
    <on_before_convert><![CDATA[log_info("target-entry"); resolve();]]></on_before_convert>
    <on_append_log><![CDATA[data.message = "P:" + data.message; throw new Error("h1-boom");]]></on_append_log>
    <on_append_log><![CDATA[data.message = data.message + ":S";]]></on_append_log>
  </gui>
</root>
