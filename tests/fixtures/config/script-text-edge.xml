        <on_append_log name="实体与CDATA探针" timeout="5000">
            data.message = data.message + " <probe>";
        </on_append_log>
    </gui>
    <list>
        <item file="a.xlsx" scheme="s" name="甲乙丙"></item>
    </list>
</root>
