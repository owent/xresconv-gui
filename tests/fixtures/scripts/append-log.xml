<?xml version="1.0" encoding="UTF-8"?>
<root>
    <global>
        <work_dir>.</work_dir>
        <xresloader_path>xresloader.jar</xresloader_path>
        <output_type>bin</output_type>
    </global>
    <gui>
        <on_append_log name="hook一" timeout="5000">
            data.message = "[hook1]" + data.message;
            globalThis.__hook1_seen = (globalThis.__hook1_seen || 0) + 1;
        </on_append_log>
        <on_append_log name="hook二" timeout="5000">
            data.message = data.message + "[hook2]";
            if (typeof globalThis.__hook1_seen === "number") {
                data.module_name = (data.module_name || "") + "+shared-ctx";
            }
        </on_append_log>
    </gui>
    <list>
        <item file="a.xlsx" scheme="s" name="条目甲"></item>
    </list>
</root>
