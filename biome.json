{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": true,
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "scripts/**",
      "!**/dist",
      "!**/node_modules",
      "!**/generated",
      "!**/test-results",
      "!packages/backend/test/fixtures/service/custom-selectors-bad.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "recommended": true,
      "style": {
        "noParameterProperties": "error",
        "noEnum": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
