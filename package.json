{
  "name": "xresconv-gui",
  "version": "2.6.0",
  "publisher": "owent",
  "description": "xresconv 批量转表工具-GUI (Tauri 2 薄壳 + Node.js 业务内核)",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/desktop"
  ],
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "compressing": "^2.1.3",
    "log4js": "^6.9.1",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tauri-apps/cli": "2.11.5",
    "markdownlint-cli": "0.49.1"
  },
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "package:windows": "node --experimental-strip-types scripts/package-windows.ts",
    "package:linux": "node --experimental-strip-types scripts/package-linux.ts",
    "package:macos": "node --experimental-strip-types scripts/package-macos.ts",
    "lint": "biome check apps packages && markdownlint \"docs/plan/**/*.md\" \"Plan.md\"",
    "typecheck": "yarn workspaces foreach -A --include '@xresconv/*' run typecheck",
    "test:unit": "yarn workspaces foreach -A --include '@xresconv/*' run test",
    "test:contracts": "yarn workspace @xresconv/contracts test",
    "test:shell": "cargo test --workspace --locked",
    "check:shell": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "test:browser": "yarn workspace @xresconv/desktop build && yarn workspace @xresconv/desktop exec playwright test",
    "test:desktop": "node tests/desktop/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xresloader/xresconv-gui.git"
  },
  "author": "owent",
  "license": "MIT",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/xresloader/xresconv-gui/blob/master/LICENSE"
    }
  ],
  "bugs": {
    "url": "https://github.com/xresloader/xresconv-gui/issues"
  },
  "homepage": "https://github.com/xresloader/xresconv-gui"
}
