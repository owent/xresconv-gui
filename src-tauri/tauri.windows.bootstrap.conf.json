{
  "$schema": "https://schema.tauri.app/config/2/",
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"]
      }
    },
    "resources": {
      "../build/release-layout/runtime": "runtime",
      "../build/release-layout/app": "app",
      "../build/release-layout/runtime-manifest.json": "runtime-manifest.json"
    }
  }
}
